{
  "name": "guia-da-ti-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/prepare.mjs",
    "dev": "npm run catalog && vite --host 127.0.0.1",
    "build": "npm run catalog && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node scripts/check-ui.mjs",
    "test:location": "node --test scripts/community-location.test.mjs",
    "test:pagination": "node --test scripts/pagination.test.mjs",
    "test:search": "node --test scripts/resource-search.test.mjs",
    "test:study": "node --test scripts/study-ranking.test.mjs"
  },
  "dependencies": {
    "@hyperframes/player": "0.8.141",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
