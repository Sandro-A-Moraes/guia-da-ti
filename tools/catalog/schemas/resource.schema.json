{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "type",
    "name",
    "summary",
    "description",
    "areas",
    "technologies",
    "languages",
    "updatedAt"
  ],
  "properties": {
    "discussionNumber": { "type": "integer", "minimum": 1 },
    "imageUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "pattern": "^https://"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "type": {
      "enum": [
        "courses",
        "platforms",
        "universities",
        "bootcamps",
        "roadmaps",
        "books",
        "certifications",
        "news",
        "blogs",
        "newsletters",
        "podcasts",
        "youtube",
        "creators",
        "articles",
        "tutorials",
        "studies",
        "case-studies",
        "reports",
        "communities",
        "events",
        "meetups",
        "conferences",
        "hackathons",
        "tools",
        "open-source",
        "challenges",
        "labs",
        "jobs",
        "scholarships",
        "mentoring",
        "volunteering"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "pattern": "^https://"
    },
    "areas": {
      "$ref": "#/definitions/ids"
    },
    "technologies": {
      "$ref": "#/definitions/optionalIds"
    },
    "languages": {
      "$ref": "#/definitions/ids"
    },
    "countries": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "demo": {
      "type": "boolean"
    },
    "communityLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "states"],
          "properties": {
            "scope": {
              "const": "regional"
            },
            "states": {
              "type": "array",
              "minItems": 1,
              "maxItems": 27,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "AC",
                  "AL",
                  "AP",
                  "AM",
                  "BA",
                  "CE",
                  "DF",
                  "ES",
                  "GO",
                  "MA",
                  "MT",
                  "MS",
                  "MG",
                  "PA",
                  "PB",
                  "PR",
                  "PE",
                  "PI",
                  "RJ",
                  "RN",
                  "RS",
                  "RO",
                  "RR",
                  "SC",
                  "SP",
                  "SE",
                  "TO"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "enum": ["national", "international"]
            }
          }
        }
      ]
    },
    "communityPlatforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "whatsapp",
          "telegram",
          "discord",
          "slack",
          "facebook",
          "linkedin",
          "meetup",
          "reddit",
          "github",
          "discourse",
          "circle",
          "mighty-networks",
          "website",
          "other"
        ]
      }
    },
    "communityModality": {
      "enum": ["online", "in-person", "hybrid"]
    },
    "creatorCategories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "education",
          "career",
          "humor",
          "lifestyle",
          "news",
          "reviews",
          "projects",
          "other"
        ]
      }
    },
    "communityAudience": {
      "enum": ["general", "male", "female", "lgbt"]
    },
    "communityLinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url"],
        "properties": {
          "platform": {
            "enum": [
              "whatsapp",
              "telegram",
              "discord",
              "slack",
              "facebook",
              "linkedin",
              "meetup",
              "reddit",
              "github",
              "discourse",
              "circle",
              "mighty-networks",
              "website",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "pattern": "^https://"
          }
        }
      }
    },
    "communityMembers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "checkedAt"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "moreThan": {
          "type": "boolean"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "universityType": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sections"],
      "properties": {
        "level": {
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/roadmapSection" }
        }
      }
    }
  },
  "definitions": {
    "roadmapId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "roadmapSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/definitions/roadmapId" },
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": { "$ref": "#/definitions/roadmapStep" }
        }
      }
    },
    "roadmapStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "importance"],
      "properties": {
        "id": { "$ref": "#/definitions/roadmapId" },
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "importance": { "enum": ["essential", "recommended", "optional"] },
        "choice": { "$ref": "#/definitions/roadmapId" },
        "resources": { "$ref": "#/definitions/roadmapResources" },
        "links": { "$ref": "#/definitions/roadmapLinks" },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/roadmapSubstep" }
        }
      }
    },
    "roadmapSubstep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "importance"],
      "properties": {
        "id": { "$ref": "#/definitions/roadmapId" },
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "importance": { "enum": ["essential", "recommended", "optional"] },
        "resources": { "$ref": "#/definitions/roadmapResources" },
        "links": { "$ref": "#/definitions/roadmapLinks" }
      }
    },
    "roadmapResources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "slug"],
        "properties": {
          "type": { "type": "string", "maxLength": 40 },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          }
        }
      }
    },
    "roadmapLinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "pattern": "^https://"
          }
        }
      }
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "optionalIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["roadmap"]
      },
      "then": {
        "properties": {
          "type": {
            "const": "roadmaps"
          }
        },
        "not": {
          "required": ["url"]
        }
      },
      "else": {
        "required": ["url"]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["communityLocation"]
          },
          {
            "required": ["communityPlatforms"]
          },
          {
            "required": ["communityModality"]
          },
          {
            "required": ["communityAudience"]
          },
          {
            "required": ["communityLinks"]
          },
          {
            "required": ["communityMembers"]
          }
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "communities"
          }
        }
      }
    },
    {
      "if": {
        "required": ["creatorCategories"]
      },
      "then": {
        "properties": {
          "type": {
            "enum": ["creators", "youtube"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["communityLinks"]
      },
      "then": {
        "required": ["communityPlatforms"]
      }
    },
    {
      "if": {
        "required": ["universityType"]
      },
      "then": {
        "properties": {
          "type": {
            "const": "universities"
          }
        }
      }
    }
  ]
}
